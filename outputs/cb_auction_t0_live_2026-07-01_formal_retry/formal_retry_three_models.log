[2026-07-01 09:35:21] RUN: python3 -c 
import json
from pathlib import Path
import pandas as pd
out=Path('outputs/cb_auction_t0_live_2026-07-01_formal_retry')
rows=[]
summary=[]
for path in sorted(out.glob('2026-07-01_cb_auction_t0*.json')):
    data=json.loads(path.read_text(encoding='utf-8'))
    model=data.get('model')
    trigger_text='、'.join(f"{s.get('trigger_stock_name')}({s.get('trigger_stock_code')},封单{s.get('fd_amount_yi')}亿)" for s in data.get('trigger_stocks',[]))
    concept_text='、'.join(f"{c.get('concept_name')}({round(float(c.get('concept_strength') or 0),4)})" for c in data.get('concepts',[]))
    summary.append({
        'model': model,
        'trigger_count': len(data.get('trigger_stocks', [])),
        'triggers': trigger_text,
        'concepts': concept_text,
        'main_bonds': len(data.get('bonds', [])),
        'observation_bonds': len(data.get('observation_bonds', [])),
        'rejections': json.dumps(data.get('rejections', [])[:10], ensure_ascii=False),
    })
    for list_type,key in [('主买','bonds'),('观察','observation_bonds')]:
        for i,b in enumerate(data.get(key,[]) or [],1):
            rows.append({
                'model': model,
                'list_type': list_type,
                'rank': i,
                'trigger_stocks': trigger_text,
                'selected_concepts': concept_text,
                'cb_code': b.get('cb_code'),
                'cb_name': b.get('cb_name'),
                'stk_name': b.get('stk_name'),
                'matched_concepts': '、'.join(b.get('matched_concepts') or []),
                'quality_tier': b.get('quality_tier'),
                'observation_reason': b.get('observation_reason'),
                'risk_notes': '；'.join(b.get('risk_notes') or []),
            })
sm=pd.DataFrame(summary)
sm.to_csv(out/'2026-07-01_formal_three_models_summary.csv',index=False,encoding='utf-8-sig')
print('SUMMARY')
print(sm.to_string(index=False))
if rows:
    df=pd.DataFrame(rows)
    df.to_csv(out/'2026-07-01_formal_three_models_detail.csv',index=False,encoding='utf-8-sig')
    print('\nDETAIL')
    print(df.to_string(index=False))
else:
    pd.DataFrame(rows).to_csv(out/'2026-07-01_formal_three_models_detail.csv',index=False,encoding='utf-8-sig')
    print('\nDETAIL: no bonds')

