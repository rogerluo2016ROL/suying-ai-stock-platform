import os, psycopg2, json
conn=psycopg2.connect(os.environ['KRONOS_PG_URL'])
cur=conn.cursor()
out={}
for t,col in [('limit_list_d','trade_date'),('stk_auction_o','trade_date'),('cb_daily','trade_date'),('daily_kline','trade_date')]:
    cur.execute(f"select max({col}), count(*) from {t}")
    out[t]=[str(x) for x in cur.fetchone()]
for t,col in [('limit_list_d','trade_date'),('stk_auction_o','trade_date')]:
    cur.execute(f"select count(*) from {t} where {col} in (%s,%s)", ('2026-07-01','20260701'))
    out[t+'_today_rows']=cur.fetchone()[0]
cur.execute("SELECT limit_type, COUNT(*) FROM limit_list_d WHERE trade_date::text IN (%s,%s) GROUP BY limit_type ORDER BY limit_type", ('2026-07-01','20260701'))
out['limit_list_d_today_by_type']=[list(x) for x in cur.fetchall()]
print(json.dumps(out,ensure_ascii=False,default=str))
conn.close()

