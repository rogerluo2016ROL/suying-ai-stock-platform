[2026-07-01 09:26:06] RUN: python3 -c 
import json
from pathlib import Path
import pandas as pd
out=Path('outputs/cb_auction_t0_live_2026-07-01_0926')
rows=[]
for path in sorted(out.glob('2026-07-01_cb_auction_t0*.json')):
    data=json.loads(path.read_text(encoding='utf-8'))
    model=data.get('model')
    for list_type,key in [('主买','bonds'),('观察','observation_bonds')]:
        for i,b in enumerate(data.get(key,[]) or [],1):
            rows.append({
                'model': model,
                'list_type': list_type,
                'rank': i,
                'trigger_stocks': '、'.join(f"{s.get('trigger_stock_name')}({s.get('trigger_stock_code')},封单{s.get('fd_amount_yi')}亿)" for s in data.get('trigger_stocks',[])),
                'selected_concepts': '、'.join(f"{c.get('concept_name')}({round(float(c.get('concept_strength') or 0),4)})" for c in data.get('concepts',[])),
                'cb_code': b.get('cb_code'),
                'cb_name': b.get('cb_name'),
                'stk_name': b.get('stk_name'),
                'matched_concepts': '、'.join(b.get('matched_concepts') or []),
                'quality_tier': b.get('quality_tier'),
                'observation_reason': b.get('observation_reason'),
                'risk_notes': '；'.join(b.get('risk_notes') or []),
            })
    print(path.name)
    print('  model=', model)
    print('  triggers=', len(data.get('trigger_stocks', [])), data.get('trigger_stocks', [])[:5])
    print('  concepts=', [(c.get('concept_name'), c.get('concept_strength')) for c in data.get('concepts', [])])
    print('  main_bonds=', len(data.get('bonds', [])))
    print('  observation_bonds=', len(data.get('observation_bonds', [])))
    print('  rejections=', data.get('rejections', [])[:8])
if rows:
    df=pd.DataFrame(rows)
    df.to_csv(out/'2026-07-01_three_t0_models_detail.csv',index=False,encoding='utf-8-sig')
    print('\nDETAIL')
    print(df.to_string(index=False))
else:
    pd.DataFrame(rows).to_csv(out/'2026-07-01_three_t0_models_detail.csv',index=False,encoding='utf-8-sig')
    print('\nDETAIL: no bonds')

