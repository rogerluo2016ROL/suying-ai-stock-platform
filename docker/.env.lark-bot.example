# 飞书 bot 配置模板 — 复制为 .env.lark-bot 并填入真实值（.env.lark-bot 已 gitignore，勿提交）
# 使用方: screener-service / data-service (docker-compose env_file)

# 飞书自建应用凭据（必填）
LARK_APP_ID=
LARK_APP_SECRET=

# 事件订阅验证 token（lark_event_bridge 用，可选）
LARK_EVENT_VERIFICATION_TOKEN=

# 允许的群/用户白名单（逗号分隔，可选）
LARK_ALLOWED_CHAT_IDS=
LARK_ALLOWED_USER_OPEN_IDS=

# lark-cli profile（多应用切换，可选）
LARK_CLI_PROFILE=
