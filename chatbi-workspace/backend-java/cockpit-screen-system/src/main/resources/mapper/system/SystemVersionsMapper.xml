<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ds.cockpit.screen.system.mapper.SystemVersionsMapper">

    <resultMap id="SystemVersionsResult" type="SystemVersionsEntity">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="title" column="title" jdbcType="VARCHAR"/>
            <result property="content" column="content" jdbcType="VARCHAR"/>
            <result property="influenceScope" column="influence_scope" jdbcType="VARCHAR"/>
            <result property="implementTime" column="implement_time" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="availability" column="availability" jdbcType="INTEGER"/>
            <result property="released" column="released" jdbcType="INTEGER"/>
            <result property="userId" column="user_id" jdbcType="VARCHAR"/>
            <result property="descriptions" column="descriptions" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,title,content,influenceScope,implementTime,
        create_time,availability,released,userId,descriptions,updateTime
    </sql>

    <select id="getVersions" resultMap="SystemVersionsResult" parameterType="com.ds.cockpit.screen.common.core.domain.entity.vo.SystemVersionsVo">
        SELECT *
        FROM system_versions
        WHERE availability = 1
            <if test="vo.content != null and vo.content != ''">
                AND content LIKE CONCAT('%',#{vo.content},'%')
            </if>
            <if test="vo.influenceScope != null and vo.influenceScope != ''">
                AND influence_scope LIKE CONCAT('%',#{vo.influenceScope},'%')
            </if>
            <if test="vo.implementTime != null and vo.implementTime != ''">
                AND implement_time LIKE CONCAT('%',#{vo.implementTime},'%')
            </if>
            <if test="vo.userId != null and vo.userId != ''">
                AND user_id = #{vo.userId}
            </if>
            <if test="vo.descriptions != null and vo.descriptions != ''">
                AND descriptions = CONCAT('%',#{vo.descriptions},'%')
            </if>
            <if test="vo.updateTime != null and vo.updateTime != ''">
                AND update_time > #{vo.updateTime}
            </if>
            <if test="vo.released != null">
                AND released = #{vo.released}
            </if>
        ORDER BY update_time DESC
    </select>


    <insert id="insertEntity" parameterType="com.ds.cockpit.screen.common.core.domain.entity.SystemVersionsEntity">
        insert into system_versions(
        <if test="title != null and title != ''">title,</if>
        <if test="content != null and content != ''">content,</if>
        <if test="influenceScope != null and influenceScope != ''">influence_scope,</if>
        <if test="implementTime != null and implementTime != ''">implement_time,</if>
        <if test="released != null">released,</if>
        <if test="userId != null and userId != ''">user_id,</if>
        <if test="descriptions != null and descriptions != ''">descriptions,</if>
        update_time
        )values(
        <if test="title != null and title != ''">#{title},</if>
        <if test="content != null and content != ''">#{content},</if>
        <if test="influenceScope != null and influenceScope != ''">#{influenceScope},</if>
        <if test="implementTime != null and implementTime != ''">#{implementTime},</if>
        <if test="released != null">#{released},</if>
        <if test="userId != null and userId != ''">#{userId},</if>
        <if test="descriptions != null and descriptions != ''">#{descriptions},</if>
        sysdate()
        )
    </insert>

    <select id="selectByEntityId" resultMap="SystemVersionsResult">
        SELECT *
        FROM system_versions
        WHERE availability = 1
        <if test="id != null ">
            AND id = #{id}
        </if>
    </select>

    <update id="unAvailability">
        update system_versions v
        <set>
            <if test="id != null ">
                v.availability = 0
            </if>
        </set>
        where v.id = #{id,jdbcType=BIGINT}
    </update>

    <update id="updateEntity" parameterType="com.ds.cockpit.screen.common.core.domain.entity.SystemVersionsEntity">
        update system_versions
        <set>
            <if test="title != null and title != ''">
                title = #{title,jdbcType=VARCHAR},
            </if>
            <if test="content != null and content != ''">
                content = #{content,jdbcType=VARCHAR},
            </if>
            <if test="influenceScope != null and influenceScope != ''">
                influence_scope = #{influenceScope,jdbcType=VARCHAR},
            </if>
            <if test="implementTime != null and implementTime != ''">
                implement_time = #{implementTime,jdbcType=VARCHAR},
            </if>
            <if test="userId != null and userId != ''">
                user_id = #{userId,jdbcType=VARCHAR},
            </if>
            <if test="descriptions != null and descriptions != ''">
                descriptions = #{descriptions,jdbcType=VARCHAR},
            </if>
        </set>
        update_time = sysdate()
        where id = #{id,jdbcType=BIGINT}
    </update>

    <update id="released">
        update system_versions v
        <set>
            <if test="id != null ">
                v.released = 1
            </if>
        </set>
        where v.id = #{id,jdbcType=BIGINT}
    </update>

    <update id="recall">
        update system_versions v
        <set>
            <if test="id != null ">
                v.released = 0
            </if>
        </set>
        where v.id = #{id,jdbcType=BIGINT}
    </update>

</mapper>
