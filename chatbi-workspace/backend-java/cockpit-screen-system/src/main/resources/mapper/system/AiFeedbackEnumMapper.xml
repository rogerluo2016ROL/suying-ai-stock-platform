<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ds.cockpit.screen.system.mapper.AiFeedbackEnumMapper">

    <resultMap id="AiFeedbackEnumResult" type="AiFeedbackEnumEntity">
        <id     property="id"           column="id"             jdbcType="BIGINT"/>
        <result property="types"        column="types"          jdbcType="VARCHAR"/>
        <result property="nameValue"    column="name_value"     jdbcType="VARCHAR"/>
        <result property="availability" column="availability"   jdbcType="VARCHAR"/>
        <result property="dictSort"     column="dict_sort"      jdbcType="INTEGER"/>
        <result property="createTime"   column="create_time"    jdbcType="TIMESTAMP"/>
        <result property="updateTime"   column="update_time"    jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="selectById" resultMap="AiFeedbackEnumResult">
        select
        id, types, name_value, availability, dict_sort, create_time, update_time
        from
            ai_feedback_enum
        where id = #{id}
    </select>


    <select id="getFeedbackEnumQ" resultType="String">
        SELECT
            name_value
        FROM ai_feedback_enum
        where  availability = '1' and types = 'Q'
        order by dict_sort
    </select>

    <select id="getFeedbackEnumA" resultType="String">
        SELECT
            name_value
        FROM ai_feedback_enum
        where availability = '1' and types = 'A'
        ORDER BY dict_sort
    </select>

</mapper>
