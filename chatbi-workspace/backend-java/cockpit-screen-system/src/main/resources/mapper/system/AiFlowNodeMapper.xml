<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ds.cockpit.screen.system.mapper.AiFlowNodeMapper">

    <resultMap id="AiFlowNodeResult" type="AiFlowNodeEntity">
        <id     property="id"           column="id"             jdbcType="BIGINT"/>
        <result property="types"        column="types"          jdbcType="VARCHAR"/>
        <result property="nodeName"     column="node_name"      jdbcType="VARCHAR"/>
        <result property="nickName"     column="nick_name"      jdbcType="VARCHAR"/>
        <result property="availability" column="availability"   jdbcType="VARCHAR"/>
        <result property="isShow"       column="is_show"        jdbcType="VARCHAR"/>
        <result property="dictSort"     column="dict_sort"      jdbcType="INTEGER"/>
        <result property="createTime"   column="create_time"    jdbcType="TIMESTAMP"/>
        <result property="updateTime"   column="update_time"    jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="selectById" resultMap="AiFlowNodeResult">
        select
            id, types, node_name, nick_name, availability, is_show, dict_sort, create_time, update_time
        from
            ai_flow_node
        where id = #{id}
    </select>


    <select id="getAiFlowNodeList" resultMap="AiFlowNodeResult">
        SELECT
            id, types, node_name, nick_name, availability, is_show, dict_sort, create_time, update_time
        FROM ai_flow_node
        where  availability = '1' and is_show = '1'
    </select>

    <select id="getAiFlowNodeAllList" resultMap="AiFlowNodeResult">
        SELECT
            id, types, node_name, nick_name, availability, is_show, dict_sort, create_time, update_time
        FROM ai_flow_node
        where  availability = '1'
    </select>

</mapper>
