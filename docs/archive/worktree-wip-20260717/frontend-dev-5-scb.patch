+}
+
+function scoreToStars(score: number | null): { filled: number; off: number } {
+  if (score === null) return { filled: 0, off: 5 }
+  const filled = Math.max(0, Math.min(5, Math.round(score / 20)))
+  return { filled, off: 5 - filled }
+}
