{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "_comment_otel": "Uncomment to enable OpenTelemetry export. See .claude/standards/observability.md for setup.",
    "_OTEL_LOG_USER_PROMPTS_NOTE": "set to 0 in production; 1 only in dev to debug prompt content",
    "_OTEL_EXAMPLE_CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "_OTEL_EXAMPLE_OTEL_METRICS_EXPORTER": "otlp",
    "_OTEL_EXAMPLE_OTEL_LOGS_EXPORTER": "otlp",
    "_OTEL_EXAMPLE_OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318",
    "_OTEL_EXAMPLE_OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "_comment_agf_hooks": "Hook 运行时控制（ADR-014）：AGF_HOOK_PROFILE=minimal|standard（默认 standard，未设=standard=零回归）；AGF_DISABLED_HOOKS=id1,id2。须在 shell export 或本 env 块设实际值才生效（注释占位不生效）。四层防御 + validate-verdict 永不响应 profile。原遥测开关（AGF_OBSERVE/AGF_GOVERNANCE_LOG）已按 ADR-026 D6 退役。"
  },
  "teammateMode": "auto",
  "fallbackModel": ["claude-sonnet-4-6", "claude-haiku-4-5-20251001"],
  "autoMemoryEnabled": true,
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm test*)",
      "Bash(pnpm run lint*)",
      "Bash(pnpm run build*)",
      "Bash(pnpm run typecheck*)",
      "Bash(pnpm install*)",
      "Bash(python -m pytest*)",
      "Bash(ruff*)",
      "Bash(black*)",
      "Bash(alembic*)",
      "Bash(docker compose*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(gh issue create*)",
      "Bash(gh issue close*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue comment*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh release view*)",
      "Bash(gh release list*)",
      "Bash(gh api*)",
      "Bash(gh search*)",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.p12)",
      "Read(./**/*.mobileprovision)",
      "Read(./**/*.p8)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/config)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.pgpass)",
      "Bash(eval *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agf-hook-guard.sh session-start-context \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start-context.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scan-secrets.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch|Read|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sanitize-tool-output.sh"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agf-hook-guard.sh teammate-keepalive \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/teammate-keepalive.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agf-hook-guard.sh check-progress-file \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-progress-file.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-verdict.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agf-hook-guard.sh check-progress-file \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-progress-file.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-verdict.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-bash.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-config-edit.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/enforce-write-scope.sh"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agf-hook-guard.sh validate-task-schema \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-task-schema.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agf-hook-guard.sh gate-deploy-release-auth \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-deploy-release-auth.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agf-hook-guard.sh gate-redo-fuse \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-redo-fuse.sh"
          }
        ]
      }
    ]
  }
}
